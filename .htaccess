Options -Indexes
RewriteEngine On
RewriteRule ^\. - [F,L]
RewriteRule ^$ - [L]
RewriteRule ^index\.php$ - [L,NC]
RewriteRule ^(trens|trens_form|sensores|sensores_form|rotas|rotas_form|leituras|simulador|notificacoes_alertas|sair)\.php$ - [L,NC]
RewriteRule ^api(/|$) - [L,NC]
RewriteRule ^public/assets(/|$) - [L,NC]
RewriteRule . - [F,L]
